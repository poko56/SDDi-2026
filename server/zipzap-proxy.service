[Unit]
Description=ZipZap AI proxy (Gemini with per-user daily limits)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/zipzap-proxy/zipzap_proxy.py
EnvironmentFile=/etc/zipzap-proxy.env
DynamicUser=yes
StateDirectory=zipzap-proxy
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=200M

[Install]
WantedBy=multi-user.target
